# tiiny configuration. Copy to .env and edit: cp .env.example .env
# Loaded from the working directory at startup; real env vars win.
# Values are trimmed; empty values count as unset. Commented lines show the default.
# Bools accept true/false, 1/0, yes/no, on/off (any case).
# Durations take seconds (60) or units, combinable: 90s, 10m, 1h30m, 7d, 2w.

## Server

# Public origin of short links. No userinfo/path/query/fragment.
# Required with SMTP or OAuth (email links and callbacks never trust the request's Host).
# Set it in production: Secure cookies on https, absolute canonical/OG URLs and a sitemap.
# Unset, short URLs use the request's host over http.
# TIINY_BASE_URL=https://tii.example.com
# Listen address, unprefixed as most platforms set them. HOST takes an IP or a hostname.
# HOST=0.0.0.0
# PORT=8080
# Created at startup; holds tiiny.db. /data in Docker.
# TIINY_DATA_DIR=./.data
# Log filter (tracing EnvFilter syntax). Default: info.
# TIINY_LOG=info,tiiny=debug
# JSON lines in <data dir>/logs: tiiny.YYYY-MM-DD.log per UTC day, 7 kept, latest.log points at today's.
# Stdout logging is always on.
# TIINY_LOG_FILE=true

## Database (Turso embedded replica; set URL and token together, or neither for a local file)

# TIINY_DATABASE_URL=libsql://your-db.turso.io
# TIINY_DATABASE_AUTH_TOKEN=
# Background pull from the primary, > 0. Writes go to the primary: deploy near it.
# TIINY_REPLICA_SYNC_INTERVAL=5s

## Cache and stats

# Redirect cache.
# TIINY_CACHE_TTL=60s
# TIINY_CACHE_MAX_ENTRIES=100000
# Click stats are batched in memory.
# TIINY_STATS_FLUSH_INTERVAL=10s
# Whole days, at least 1d (e.g. 90d). Unset: keep forever.
# TIINY_STATS_RETENTION=

## Links

# Unset: unlimited.
# TIINY_MAX_LINKS_PER_USER_PER_DAY=
# Anonymous (and unverified-email) users may create random-slug temporary links.
# TIINY_GUEST_LINKS_ENABLED=true
# Per client IP, shared by guests and unverified-email users; 0 disables both.
# TIINY_MAX_GUEST_LINKS_PER_IP_PER_DAY=20
# Comma-separated destination domains to refuse.
# TIINY_BLOCKED_DOMAINS=

## Accounts

# TIINY_SIGNUP_ENABLED=true
# TIINY_PASSWORD_AUTH_ENABLED=true
# Comma-separated; made admin at startup and sign-up (see README "Admin").
# TIINY_ADMIN_EMAILS=you@example.com

## OAuth (id and secret together; callbacks in README "OAuth")

# TIINY_GOOGLE_CLIENT_ID=
# TIINY_GOOGLE_CLIENT_SECRET=
# TIINY_GITHUB_CLIENT_ID=
# TIINY_GITHUB_CLIENT_SECRET=

## Email (host enables it; FROM required with it; password required with username)

# TIINY_SMTP_HOST=smtp.example.com
# Default 587, or 465 when TLS is tls.
# TIINY_SMTP_PORT=587
# TIINY_SMTP_USERNAME=
# TIINY_SMTP_PASSWORD=
# TIINY_SMTP_FROM=tiiny <noreply@example.com>
# starttls, tls or none.
# TIINY_SMTP_TLS=starttls
# How often admins get one summary email of new abuse reports (only when there are some).
# TIINY_REPORT_EMAIL_INTERVAL=1h

## Network

# Header carrying the client IP behind a proxy (see README "Client IP").
# TIINY_CLIENT_IP_HEADER=
# GeoLite2-Country .mmdb. CF-IPCountry wins when set, but is only read with TIINY_CLIENT_IP_HEADER=CF-Connecting-IP.
# TIINY_GEOIP_DB_PATH=
