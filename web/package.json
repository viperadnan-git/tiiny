{
	"name": "web",
	"description": "Self-hosted link shortener that counts clicks, not people. Custom slugs, privacy-friendly stats and an admin panel in one small binary.",
	"author": "Adnan Ahmad <viperadnan@gmail.com>",
	"homepage": "https://github.com/viperadnan-git/tiiny",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/viperadnan-git/tiiny.git",
		"directory": "web"
	},
	"devDependencies": {
		"@dicebear/core": "^9.4.3",
		"@dicebear/rings": "^9.4.2",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource-variable/public-sans": "^5.3.0",
		"@fontsource/courier-prime": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.70.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.20.6",
		"cn": "^0.5.2",
		"formsnap": "^2.1.0",
		"layerchart": "^2.9.2",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.8.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"sveltekit-superforms": "^3.1.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.6",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"license": "MIT",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && touch build/.gitkeep",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun scripts/check-safe-next.ts && bun scripts/check-schemas.ts",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"type": "module"
}
